# Copy to .env and replace all example values before deployment.
POSTGRES_DB=key_validation
POSTGRES_USER=keyvalidation
POSTGRES_PASSWORD=replace-with-a-long-random-password
LICENSING_KEY_V1=replace-with-base64-encoded-32-random-bytes
# Absolute paths to an existing TLS certificate chain and private key.
TLS_CERT_PATH=/path/to/fullchain.pem
TLS_KEY_PATH=/path/to/privkey.pem
HTTPS_PORT=443
# MCP requires exact public hostname (no scheme/port) and HTTPS origin (with
# non-default port if used). Indexed overrides replace all default loopback hosts.
MCP_ALLOWED_HOST=licenses.example.com
MCP_ALLOWED_ORIGIN=https://licenses.example.com

# Backup is opt-in. Set BACKUP_PATH=/app/backups and a separately stored,
# Base64-encoded 32-byte random encryption key before enabling the schedule.
BACKUP_PATH=
BACKUP_ENCRYPTION_KEY=
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=7
BACKUP_MAX_ARCHIVE_BYTES=268435456
# Exact HTTPS webhook hostname; leave empty to deny external webhooks.
WEBHOOK_ALLOWED_HOST=
